{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "cyberthunder",
            "volumeMounts": [
              {
                "name": "target-credentials",
                "mountPath": "/etc/cyberthunder/targets",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "target-credentials",
            "secret": {
              "secretName": "cyberthunder-target-credentials",
              "defaultMode": 288
            }
          }
        ]
      }
    }
  }
}
