@page { size: letter; margin: 0.45in; }
* { box-sizing: border-box; }
body { font: 10pt/1.35 "Segoe UI", Arial, sans-serif; color: #111; margin: 0 auto; max-width: 8in; padding: 0.2in; }
h1 { font-size: 15pt; margin: 0 0 2pt; }
h2 { font-size: 10.5pt; margin: 9pt 0 3pt; border-bottom: 1px solid #444; text-transform: uppercase; letter-spacing: .04em; }
p { margin: 2pt 0; }
table { border-collapse: collapse; width: 100%; font-size: 9pt; }
th, td { border: 1px solid #999; padding: 2pt 4pt; text-align: left; vertical-align: top; }
th { background: #e6e6e6; }
td.n, th.n { text-align: right; }
ul { margin: 2pt 0 2pt 14pt; padding: 0; }
.meta { font-size: 8.5pt; color: #333; }
.bluf { border: 1.5px solid #111; padding: 4pt 6pt; margin: 6pt 0; background: #f6f6f6; }
.bad { color: #a00000; font-weight: bold; }
.ok { color: #145214; font-weight: bold; }
code { font: 8.5pt Consolas, "Courier New", monospace; word-break: break-all; }
.approval-evidence pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 8pt; }
.approval-receipts { table-layout: fixed; }
.approval-receipts td, .approval-reviewers { white-space: pre-line; overflow-wrap: anywhere; }
.foot { margin-top: 8pt; border-top: 1px solid #444; padding-top: 3pt; font-size: 8pt; color: #333; }
@media print { body { padding: 0; } }
