<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Commander one-pager - {{ r.node }} - {{ r.scan_id }}</title>
<style>
{% include "_style.css.j2" %}
</style>
</head>
<body>
<h1>Cyber Thunder - Commander one-pager</h1>
<p class="meta">Unit / enclave: <b>{{ r.node }}</b> | Date: {{ r.date }} | Scan: <code>{{ r.scan_id }}</code> ({{ r.trigger }}) |
 Audit chain: {% if r.audit.ok %}<span class="ok">intact</span>{% else %}<span class="bad">BROKEN: {{ r.audit.detail }}</span>{% endif %},
 {{ r.audit.count }} records, head <code>{{ r.audit.head }}</code></p>

<div class="bluf"><b>BLUF.</b> {% for s in r.bluf %}{{ s }} {% endfor %}</div>

<h2>Open findings requiring action by host</h2>
<p class="meta">Excludes verified changes and active review suppressions. Original scanner observations and all suppressed findings remain in the evidence below.</p>
{% if r.by_host %}
<table>
<tr><th>Host</th><th class="n">CAT I</th><th class="n">CAT II</th><th class="n">CAT III</th><th class="n">Total open</th><th class="n">Intrusion indicators</th></tr>
{% for row in r.by_host %}
<tr><td>{{ row.host }}</td><td class="n">{{ row.high }}</td><td class="n">{{ row.medium }}</td><td class="n">{{ row.low }}</td><td class="n">{{ row.total }}</td><td class="n">{{ row.hunt }}</td></tr>
{% endfor %}
</table>
{% else %}
<p>No open findings requiring action. Unchecked results and errors still need investigation.</p>
{% endif %}

<h2>Intrusion indicators</h2>
{% if r.hunt %}
<table>
<tr><th>Host</th><th>Indicator</th><th>ATT&amp;CK</th></tr>
{% for h in r.hunt %}
<tr><td>{{ h.host }}</td><td>{{ h.title }}</td><td>{{ h.attack | join(", ") or "-" }}</td></tr>
{% endfor %}
</table>
{% else %}
<p>No unsuppressed open intrusion indicators in the available observations; this is not proof of absence.</p>
{% endif %}

{% if r.discovery %}
<h2>Unknown devices and changes on the enclave</h2>
<table>
<tr><th>Host or address</th><th>Item</th><th>Severity</th></tr>
{% for d in r.discovery %}
<tr><td>{{ d.host }}</td><td>{{ d.title }}</td><td>{{ d.severity }}</td></tr>
{% endfor %}
</table>
{% endif %}

<h2>Decisions</h2>
<p>Pending {{ r.decisions.proposed }} | Approved {{ r.decisions.approved }} | Applied {{ r.decisions.applied }} |
 Verified {{ r.decisions.verified }} | Rolled back {{ r.decisions.rolled_back }} | Failed {{ r.decisions.failed }} | Denied {{ r.decisions.denied }}</p>
{% if r.verified %}
<table>
<tr><th>Verified change</th><th>Host</th><th>Approved by</th><th>Verified at (UTC)</th></tr>
{% for v in r.verified %}
<tr><td>{{ v.title }}</td><td>{{ v.host }}</td><td>{{ v.decision_identity.text }}</td><td>{{ v.verified_at or "-" }}</td></tr>
{% endfor %}
</table>
{% else %}
<p>No verified changes yet.</p>
{% endif %}
{% if r.reverted %}
<table>
<tr><th>Reverted or failed change</th><th>Host</th><th>Approved by</th><th>When (UTC)</th><th>Why</th></tr>
{% for x in r.reverted %}
<tr><td>{{ x.title }}</td><td>{{ x.host }}</td><td>{{ x.decision_identity.text }}</td><td>{{ x.at or "-" }}</td><td>{{ x.why }}</td></tr>
{% endfor %}
</table>
{% endif %}

<h2>Top risks</h2>
{% if r.top %}
<ul>
{% for t in r.top %}
<li><b>{{ t.cat }}</b> {{ t.host }}: {{ t.title }}. {% if t.risk %}{{ t.risk }}{% else %}<i>No explanation generated yet.</i>{% endif %}
 [{{ t.citations | join(", ") }}]<br>
 Scanner status: {{ t.assurance.status }}; confidence: <b>{{ t.assurance.confidence.grade }}</b> - {{ t.assurance.confidence.reason }};
 review: {{ t.assurance.review.disposition }}. Reviewer identity: {{ t.assurance.identity_label }}.</li>
{% endfor %}
</ul>
{% else %}
<p>No open findings to rank.</p>
{% endif %}
{% if r.link %}
<h2>Link and outbox</h2>
<p>{{ r.link }}</p>
{% endif %}

<h2>Check and fix coverage</h2>
<p><b>Coverage:</b> finding every seeded item does not mean a whole benchmark is covered.
Available content mappings below describe capabilities, not checks completed in this scan.</p>
{% if r.coverage.benchmarks %}
<table><tr><th>Available benchmark</th><th>Rules</th><th>Native</th><th>SCAP eligible</th><th>Executable fix</th><th>Runbook only</th><th>Unmapped</th></tr>
{% for row in r.coverage.benchmarks %}
<tr><td>{{ row.benchmark }} ({{ row.release }})</td><td>{{ row.published_rules }}</td><td>{{ row.native_checks }}</td><td>{{ row.scap_eligible }}</td><td>{{ row.executable_fixes }}</td><td>{{ row.runbook_only }}</td><td>{{ row.not_covered }}</td></tr>
{% endfor %}</table>
{% else %}<p>Full benchmark totals are unknown; no local benchmark document is available.</p>{% endif %}
<p class="meta">Native and SCAP counts overlap. Linux SCAP needs external OpenSCAP and host applicability checks. Matching rule IDs across releases needs content review. See Reports / Check &amp; fix coverage for sources, datastreams and limitations.{% if r.coverage.errors %} Coverage inventory is incomplete; see that report's errors.{% endif %}</p>
{% include "_assurance.html.j2" %}
<h2>Next actions</h2>
<ul>
{% for a in r.next_actions %}
<li>{{ a }}</li>
{% endfor %}
</ul>

<div class="foot">Reproduce: <code>{{ r.command }}</code><br>
Every claim above comes from scanner output, the approval log or the audit chain. No change is made without a named human approving it.</div>
</body>
</html>
